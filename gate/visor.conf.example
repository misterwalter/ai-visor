# Settings for the dispatcher (dispatch.py). Copy to ~/.config/visor/visor.conf
# and fill in. This copy is an example: the real one names your projects, so it
# stays on the server and out of this repository.

[visor]
# The shared notes folder, holding inbox/, approved/, working/, your-turn/ and done/.
tasks = /srv/notes/tasks
# The agent loop: pi or qwen.
harness = pi
# The model used when a note has no Model: line: official, abliterated or both.
default_model = both
# Pull this repository while idle, reinstall, and restart when it changed.
self_update = yes
# After each build, a read-only round on its branch reviews it against the task,
# and the review is added to the note. It is an agent's review: compared with a
# person's on five builds, it caught missing functions and failing tests but not
# features nobody would see. Read it as a second opinion.
review = no
# The model that reviews: official or abliterated.
reviewer = official
# Projects made from a note ("New project:"): folder projects go here, GitHub
# projects are cloned into repos, and "GitHub: yes" means this account's
# repository of the same name. Visor records them in projects.conf beside this
# file and never rewrites this one.
# projects_folder = /srv/notes/tasks/projects
repos = /srv/code
github_owner = your-github-name
# Where each run's live log goes (default: logs/ in the notes folder), and how
# often, in seconds, it is brought up to date.
# logs = /srv/notes/tasks/logs
live_log_every = 60
# The VPN tunnel's proxy on this machine (see wireproxy.conf.example). A note
# with "Web: yes" gets the internet through it and through nothing else; while
# it is down, such a note comes back unrun.
# vpn_proxy = 127.0.0.1:25344

# Transcription, speech and images (media.py). These are the defaults, under
# tools; set any that differ. sandbox = no is for tests only.
[media]
tools = /srv/code/tools
# whisper = /srv/code/tools/whisper.cpp/build/bin/whisper-cli
# whisper_model = /srv/code/tools/models/ggml-large-v3-turbo.bin
# kokoro_python = /srv/code/tools/kokoro-venv/bin/python
# comfyui = /srv/code/tools/ComfyUI
# comfy_python = /srv/code/tools/comfy-venv/bin/python
# comfy_models = /srv/code/tools/models/comfy
threads = 16
# The longest a job may take, in minutes.
minutes = 360

# Ollama's names for the models. These are the defaults.
[models]
official = coder-official
abliterated = coder-abliterated
glimmer = glimmer-abliterated

# One section per project. source is a local clone of it; each run copies it
# afresh. A Godot project (one with a project.godot) is tested with GUT and needs
# nothing more. Any other project needs the command that runs its tests, from
# the top of the repository, before visor will build on it.
[project my-godot-game]
source = /srv/code/my-godot-game

[project my-python-tool]
source = /srv/code/my-python-tool
tests = python3 tests.py

# A folder project: a plain folder, such as one synced as notes, not a repository.
# Visor keeps its history outside it and adds its writing beside your files as
# lettered drafts, never changing a file of yours. Notes ask for Write: rounds.
[project my-story]
folder = /srv/notes/stories/my-story
# The model for notes that name none: here the writing model.
model = glimmer
