# Abliterated Qwen3-Coder-Next, same settings as the official build so the
# gate compares the weights and nothing else.
FROM huihui_ai/qwen3-coder-next-abliterated:latest
PARAMETER num_ctx 65536
PARAMETER temperature 1.0
PARAMETER top_p 0.95
PARAMETER top_k 40
PARAMETER min_p 0.01
PARAMETER repeat_penalty 1.0
