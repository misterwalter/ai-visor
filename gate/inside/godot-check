#!/usr/bin/env bash
# Check one GDScript file for errors, without running the tests.
# Exit status 0 means it compiled. Errors are printed with file and line.
# Usage: godot-check <script>
set -u
[ $# -eq 1 ] || { echo "usage: godot-check <script>" >&2; exit 2; }
exec "$(dirname "$(realpath "$0")")/door-request" "check $1"
