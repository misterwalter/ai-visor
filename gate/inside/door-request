#!/usr/bin/env bash
# Send one request through the test door and relay the answer.
# Exit status is the one the door reports; 3 if the door gave none.
# Usage: door-request <request>
set -u
printf '%s\n' "${1:?request required}" \
  | socat -t 3600 - UNIX-CONNECT:/run/gate/godot.sock \
  | awk '
      /^GATE_EXIT [0-9]+$/ { status = $2; next }
      { print }
      END {
        if (status == "") { print "the test door gave no result" > "/dev/stderr"; exit 3 }
        exit status
      }'
