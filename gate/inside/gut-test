#!/usr/bin/env bash
# Run the project's tests. Exit status 0 means every test passed.
# Usage: gut-test [--only NAME]
#
# --only NAME   run only the test files whose name contains NAME
set -u
here="$(dirname "$(realpath "$0")")"
case "${1:-}" in
  "")     request="test" ;;
  --only) request="test ${2:?--only needs a test file name}" ;;
  *)      echo "usage: gut-test [--only NAME]" >&2; exit 2 ;;
esac
exec "$here/door-request" "$request"
